# ── AGENTIQ web ───────────────────────────────────────────────────────────────
# The FULL base URL of the AGENTIQ API, INCLUDING the /api path segment.
# Requests are appended to it directly, so omitting /api produces 404s on every
# call — which is exactly what a stale Sem 6 value did.
#
#   local        http://localhost:3001/api
#   deployed     https://your-service.awsapprunner.com/api
VITE_API_URL=http://localhost:3001/api
